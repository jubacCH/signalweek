# Signalweek environment file.
# Copy to `.env` and edit before running `docker compose up`.

# --- Required in production ---------------------------------------------------

# HMAC secret used to sign session cookies. Change this to a long random string
# (e.g. `openssl rand -hex 32`) — the default value is public and MUST NOT be
# used outside local development.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional overrides ------------------------------------------------------

# SQLAlchemy URL for the application database. The default writes to the
# persistent `signalweek_data` volume so the SQLite file survives container
# restarts and `docker compose down`. Point at Postgres by setting e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@db:5432/signalweek
DATABASE_URL=sqlite:////app/data/signalweek.db

# Host port to publish the HTTP server on. Change if 8000 is already taken.
SIGNALWEEK_HTTP_PORT=8000
