<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Signalweek digest for {{ digest.user_email }}</title>
</head>
<body>
<h1>Signalweek digest</h1>
<p>For <strong>{{ digest.user_email }}</strong>, week of {{ digest.window_start | fmt_date }} to {{ digest.window_end | fmt_date }}.</p>
{% if digest.is_empty %}
<p><em>No signals this week.</em></p>
{% else %}
{% for section in digest.sections %}
<section>
<h2><a href="{{ section.source_url }}">{{ section.source_title }}</a></h2>
<ul>
{% for item in section.items %}
<li>
<a href="{{ item.url }}">{{ item.title }}</a>{% if item.published_at %} &mdash; <time>{{ item.published_at | fmt_datetime }}</time>{% endif +%}
{% if item.summary %}
<p>{{ item.summary }}</p>
{% endif %}
</li>
{% endfor %}
</ul>
</section>
{% endfor %}
{% endif %}
</body>
</html>
