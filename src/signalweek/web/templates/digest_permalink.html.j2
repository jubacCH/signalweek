{% extends "base.html.j2" %}
{% block content %}
<article id="digest-permalink" data-iso-week="{{ iso_week }}">
<hgroup>
<h1>Digest for week {{ iso_week }}</h1>
<h2>Week of {{ week_start.isoformat() }} to {{ week_end.isoformat() }}.</h2>
</hgroup>
<p>
<a href="/digest/{{ iso_week }}.md" download role="button" class="secondary outline">Download Markdown</a>
<a href="/digest/history">Back to archive</a>
</p>
{% if digest.is_empty %}
<p id="digest-empty"><em>No signals for this week.</em></p>
{% else %}
{% for section in digest.sections %}
<section>
<h3><a href="{{ section.source_url }}">{{ section.source_title }}</a></h3>
<ul>
{% for item in section.items %}
<li>
<a href="{{ item.url }}">{{ item.title }}</a>{% if item.published_at %} &mdash; <time>{{ item.published_at.strftime('%Y-%m-%d %H:%M UTC') }}</time>{% endif +%}
{% if item.summary %}
<p>{{ item.summary }}</p>
{% endif %}
</li>
{% endfor %}
</ul>
</section>
{% endfor %}
{% endif %}
</article>
{% endblock %}
