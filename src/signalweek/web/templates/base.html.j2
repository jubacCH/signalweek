<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Signalweek — a curated weekly digest of the AI industry: models, lawsuits and policy, funding, research, and industry moves.">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14131a" media="(prefers-color-scheme: dark)">
<title>{{ title }} &mdash; Signalweek</title>
<meta property="og:site_name" content="Signalweek">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }} — Signalweek">
<meta property="og:description" content="A curated weekly digest of the AI industry — models, policy, funding, research, and industry moves. One calm page every Monday.">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }} — Signalweek">
<meta name="twitter:description" content="A curated weekly digest of the AI industry — one calm page every Monday.">
<meta name="robots" content="index,follow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='2' y='14' width='2.4' height='10' rx='1.2' fill='%233b37c9' opacity='0.4'/%3E%3Crect x='6.5' y='11' width='2.4' height='13' rx='1.2' fill='%233b37c9' opacity='0.4'/%3E%3Crect x='11' y='16' width='2.4' height='8' rx='1.2' fill='%233b37c9' opacity='0.4'/%3E%3Crect x='15.5' y='6' width='2.4' height='18' rx='1.2' fill='%23f2b64a'/%3E%3Crect x='20' y='13' width='2.4' height='11' rx='1.2' fill='%233b37c9' opacity='0.4'/%3E%3Crect x='24.5' y='9' width='2.4' height='15' rx='1.2' fill='%233b37c9' opacity='0.4'/%3E%3Crect x='29' y='15' width='2.4' height='9' rx='1.2' fill='%233b37c9' opacity='0.4'/%3E%3C/svg%3E">
<link rel="stylesheet" href="{{ url_for('static', path='pico.min.css') }}">
<link rel="stylesheet" href="{{ url_for('static', path='signalweek.css') }}">
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<header class="site-header">
<nav aria-label="Primary">
<a href="/" class="wordmark" aria-label="Signalweek — home">
<svg class="sw-logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
<rect class="bar" x="2"    y="14" width="2.4" height="10" rx="1.2"/>
<rect class="bar" x="6.5"  y="11" width="2.4" height="13" rx="1.2"/>
<rect class="bar" x="11"   y="16" width="2.4" height="8"  rx="1.2"/>
<rect class="lit" x="15.5" y="6"  width="2.4" height="18" rx="1.2"/>
<rect class="bar" x="20"   y="13" width="2.4" height="11" rx="1.2"/>
<rect class="bar" x="24.5" y="9"  width="2.4" height="15" rx="1.2"/>
<rect class="bar" x="29"   y="15" width="2.4" height="9"  rx="1.2"/>
</svg>
<span>Signalweek</span>
</a>
<ul class="site-nav">
<li><a href="/"{% if nav_current == 'home' %} aria-current="page"{% endif %}>This week</a></li>
<li><a href="/issues"{% if nav_current == 'archive' %} aria-current="page"{% endif %}>Archive</a></li>
</ul>
</nav>
</header>
<main id="main" class="container">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
<div class="site-footer__inner">
<div class="site-footer__brand">
<span class="site-footer__mark" aria-hidden="true">
<svg viewBox="0 0 32 32">
<rect class="bar" x="2"    y="14" width="2.4" height="10" rx="1.2"/>
<rect class="bar" x="6.5"  y="11" width="2.4" height="13" rx="1.2"/>
<rect class="bar" x="11"   y="16" width="2.4" height="8"  rx="1.2"/>
<rect class="lit" x="15.5" y="6"  width="2.4" height="18" rx="1.2"/>
<rect class="bar" x="20"   y="13" width="2.4" height="11" rx="1.2"/>
<rect class="bar" x="24.5" y="9"  width="2.4" height="15" rx="1.2"/>
<rect class="bar" x="29"   y="15" width="2.4" height="9"  rx="1.2"/>
</svg>
</span>
<span class="site-footer__tag">Signalweek &mdash; the AI week in signal, not noise.</span>
</div>
<nav class="site-footer__nav" aria-label="Footer">
<a href="/">This week</a>
<a href="/issues">Archive</a>
<a href="#main">Back to top</a>
</nav>
</div>
</footer>
</body>
</html>
