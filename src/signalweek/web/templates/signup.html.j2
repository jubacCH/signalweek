{% extends "base.html.j2" %}
{% block content %}
<article>
<hgroup>
<h1>Create your Signalweek account</h1>
<h2>Email plus a passphrase &mdash; that's it.</h2>
</hgroup>
{% if error %}
<p role="alert" class="error">{{ error }}</p>
{% endif %}
<form method="post" action="/signup">
<label for="email">
Email
<input
  id="email"
  name="email"
  type="email"
  autocomplete="email"
  value="{{ email or '' }}"
  required
>
</label>
<label for="passphrase">
Passphrase
<input
  id="passphrase"
  name="passphrase"
  type="password"
  autocomplete="new-password"
  minlength="{{ min_passphrase_length }}"
  required
>
<small>At least {{ min_passphrase_length }} characters.</small>
</label>
<button type="submit">Sign up</button>
</form>
</article>
{% endblock %}
