{% extends "base.html.j2" %}
{% block content %}
<article>
<hgroup>
<h1>Your sources</h1>
<h2>RSS or Atom feeds Signalweek pulls signals from every week.</h2>
</hgroup>
<div class="add-source-wrap">
{% include "_source_form.html.j2" %}
</div>
<h3 class="section-heading">Currently tracking</h3>
<ul id="sources-list">
{% for source in sources %}
{% include "_source_item.html.j2" %}
{% else %}
<li id="sources-empty">
<div class="empty" role="status">
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<circle cx="12" cy="36" r="3"/>
<path d="M8 24a16 16 0 0 1 16 16"/>
<path d="M8 12a28 28 0 0 1 28 28"/>
</svg>
<em class="empty-title">No sources yet. Add one above.</em>
<p>Start with a blog or newsletter you already read. You can add and remove sources any time.</p>
</div>
</li>
{% endfor %}
</ul>
</article>
{% endblock %}
