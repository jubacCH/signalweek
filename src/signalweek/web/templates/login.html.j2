{% extends "base.html.j2" %}
{% block content %}
<article>
<hgroup>
<h1>Log in</h1>
<h2>Welcome back.</h2>
</hgroup>
{% if error %}
<p role="alert" class="error">{{ error }}</p>
{% endif %}
<form method="post" action="/login">
<label for="email">
Email
<input
  id="email"
  name="email"
  type="email"
  autocomplete="email"
  value="{{ email or '' }}"
  required
>
</label>
<label for="passphrase">
Passphrase
<input
  id="passphrase"
  name="passphrase"
  type="password"
  autocomplete="current-password"
  required
>
</label>
<button type="submit">Log in</button>
</form>
</article>
{% endblock %}
