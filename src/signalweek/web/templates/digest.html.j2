{% extends "base.html.j2" %}
{% block content %}
<article id="digest">
<hgroup>
<h1>This week's digest</h1>
<h2>Week of {{ digest.window_start.date().isoformat() }} to {{ digest.window_end.date().isoformat() }} (in progress).</h2>
</hgroup>
<p><a href="/digest/history">Browse the archive &rarr;</a></p>
{% if digest.is_empty %}
<div id="digest-empty" class="empty" role="status">
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect x="6" y="10" width="36" height="30" rx="4"/>
<path d="M6 18h36"/>
<path d="M14 6v6M34 6v6"/>
<path d="M14 28h6M14 34h20M24 28h14"/>
</svg>
<em class="empty-title">No signals this week yet.</em>
<p>Once you add sources, Signalweek starts pulling items into this digest as they land.</p>
<div class="cta">
<a href="/sources" role="button">Add your first source</a>
<a href="/digest/history">Or browse the archive</a>
</div>
</div>
{% else %}
{% for section in digest.sections %}
<section>
<h3><a href="{{ section.source_url }}">{{ section.source_title }}</a></h3>
<ul>
{% for item in section.items %}
<li>
<a href="{{ item.url }}">{{ item.title }}</a>{% if item.published_at %} &mdash; <time>{{ item.published_at.strftime('%Y-%m-%d %H:%M UTC') }}</time>{% endif +%}
{% if item.summary %}
<p>{{ item.summary }}</p>
{% endif %}
</li>
{% endfor %}
</ul>
</section>
{% endfor %}
{% endif %}
</article>
{% endblock %}
