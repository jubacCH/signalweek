{% block content %}
<section class="notfound" aria-labelledby="notfound-heading">
<p class="notfound__eyebrow" aria-hidden="true">
<span class="notfound__code">404</span>
<span class="notfound__rule"></span>
<span class="notfound__label">Off the page</span>
</p>
<hgroup>
<h1 id="notfound-heading">This week isn&rsquo;t here.</h1>
<h2>The page you asked for doesn&rsquo;t exist &mdash; a mistyped date, a link from a draft that never shipped, or an issue that hasn&rsquo;t been published yet.</h2>
